	"type": "module",
	"keywords": [
		"pi-package",
		"pi-coding-agent",
		"mcp",
		"memory",
		"persistent-memory",
		"claude-code",
		"zcode"
	],
	"license": "MIT",
	"author": "dchya24",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dchya24/pi-zcode-memory.git"
	},
	"bin": {
		"takka-memory": "bin/takka-memory.js"
	},
	"files": [
		"bin",
		"dist",
		"extensions",
		"integrations",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
